# Neon (wajib pooled endpoint `...-pooler....neon.tech` untuk serverless).
# Driver neon-http jalan di lokal maupun Cloudflare Workers.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/katalyst?sslmode=require"

# better-auth
BETTER_AUTH_SECRET="ganti-dengan-random-string-panjang"
BETTER_AUTH_URL="http://localhost:5173"

# --- Copilot (LLM, Fase 0; kunci asli hanya di .env / secret Cloudflare) ---
# Penyedia adapter OpenAI-compatible (lihat profil di src/lib/server/domains/copilot/llm/profiles.ts).
LLM_PROVIDER="groq"
# Kunci Groq dari console (tanpa kunci endpoint jawab 503).
LLM_API_KEY="ganti-dengan-kunci-groq"
# Model dipisah koma, urut prioritas; kosong berarti ikut default profil.
LLM_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"
# Opsional, menimpa baseUrl profil bila memakai gateway sendiri.
LLM_BASE_URL=""
# Maksimal pindah model per jawaban bila 429/5xx sebelum event pertama.
COPILOT_MAX_FAILOVER="2"
# Maksimal jawaban per bisnis per hari.
COPILOT_DAILY_LIMIT="40"
# Isi 1 untuk mencatat isi pertanyaan di log (default tidak dicatat).
COPILOT_DEBUG=""
# --- Dipakai HANYA oleh `npm run db:seed:real` (bootstrap production, sekali jalan) ---
# Untuk demo/portfolio pakai `npm run db:seed:demo` — script itu tidak baca variabel di bawah ini.
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
ADMIN_NAME="Nama Pemilik"
BUSINESS_NAME="Nama Usaha"
