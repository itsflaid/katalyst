# Neon (wajib pooled endpoint `...-pooler....neon.tech` untuk serverless).
# Driver neon-http jalan di lokal maupun Cloudflare Workers.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/katalyst?sslmode=require"

# better-auth
BETTER_AUTH_SECRET="ganti-dengan-random-string-panjang"
BETTER_AUTH_URL="http://localhost:5173"

# --- Dipakai HANYA oleh `npm run db:seed:real` (bootstrap production, sekali jalan) ---
# Untuk demo/portfolio pakai `npm run db:seed:demo` — script itu tidak baca variabel di bawah ini.
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
ADMIN_NAME="Nama Pemilik"
BUSINESS_NAME="Nama Usaha"
